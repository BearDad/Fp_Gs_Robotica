   "source": [
    "pan = 3.49\n",
    "pan_dia = 200\n",
    "pan_viejo = 100"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9921286b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def calcular_pan(pan_dia, pan_viejo):\n",
    "    total = (pan * pan_dia) + (pan_viejo * pan * 0.6)\n",
    "    return total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b14cc53f",
   "metadata": {},
   "outputs": [],
   "source": [
    "total = calcular_pan(pan_dia, pan_viejo)\n",
    "print(f\"En total tendra que pagar {total}€\")"
   ]
  }
